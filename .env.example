# ========================================================
# CampusBrain AI - Environment Configuration Template
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Optional: Leave empty for built-in in-memory/JSON DB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/campusbrain?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Session Token Signing
JWT_SECRET=campusbrain_rag_super_secret_jwt_key_2026

# Google Gemini API Key (Optional: Enter to use live Google Gemini 1.5/2.0 Flash)
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenRouter API Key (Optional: Enter to use OpenAI/Claude/DeepSeek models)
OPENROUTER_API_KEY=

# RAG Hyperparameters
SIMILARITY_THRESHOLD=0.20
TOP_K_RESULTS=4

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
